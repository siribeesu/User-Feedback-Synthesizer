# Hindsight Backend Configuration
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# LLM Configuration for Hindsight Docker service
# Supported providers: openai, groq, anthropic, gemini, litellm
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=your_openai_or_groq_api_key_here
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_WORKER_ID=feedback-synthesizer-worker

# App Configuration
DEFAULT_BANK_ID=mobile-app-feedback
API_PORT=8000
DASHBOARD_PORT=8501
